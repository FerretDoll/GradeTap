# Keep the API same-origin so session/CSRF cookies and EventSource streams go through the Vite proxy.
VITE_API_BASE_URL=/api
# Local FastAPI address used by the Vite /api proxy.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Development only: serve batch A/B contract samples from the in-browser mock instead of the backend.
VITE_API_MOCK=false
